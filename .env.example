# Everything is optional. A missing value makes that service run as a labelled simulation.

# Database. Leave empty to use the temporary local PGlite database in .data/
DATABASE_URL=

# Protects the whole app with a password. Required in production.
APP_PASSWORD=

# Claude agents
ANTHROPIC_API_KEY=

# Meta Marketing API. Ads are always created PAUSED unless META_ALLOW_ACTIVATE=true
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_WHATSAPP_NUMBER=
META_API_VERSION=v25.0
META_ALLOW_ACTIVATE=false

# Evolution API (Baileys). Use a dedicated test number, never your main business number.
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_TOKEN=

# Order webhooks
SHOPIFY_WEBHOOK_SECRET=
WEBSITE_WEBHOOK_SECRET=
